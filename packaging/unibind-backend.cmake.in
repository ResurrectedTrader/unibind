# unibind, the @UNIBIND_BACKEND@ backend. Included by unibind-config.cmake; not meant to be
# included directly.
#
# The imported target is written out rather than exported, because the engine
# this backend links is the consumer's to supply and a path baked into an export
# file could not be pointed anywhere else. `UNIBIND_@UNIBIND_BACKEND_UPPER@_DIR` is that
# path, defaulted to what this prefix was built against.
#
# What it defines is a **link input**, not an include path: the public headers
# and the generated `config.h` are `unibind::headers`, which is the same set
# whichever backend a consumer ends up linking. That is the whole point of the
# split - objects compiled once, linked against either engine.

set(_unibind_prefix "${CMAKE_CURRENT_LIST_DIR}/../../..")
get_filename_component(_unibind_prefix "${_unibind_prefix}" ABSOLUTE)

# The architecture this prefix was installed for. Nothing in the layout says
# so - one library per backend, one set of headers - and the header a consumer
# would compile against changes size with it.
#
# `find_package(unibind)` normally never reaches this: CMake's own generated
# version file records the bit size and refuses a prefix of the other one
# first, reporting it as "(64bit)" among the configs it would not accept. This
# is the backstop for the other ways in - a direct `include()` of this file, or
# a version file that went missing - and it says which architecture rather than
# which bit size. Past both of them the generated `config.h` names the
# architecture in its `detect_mismatch` tag, so the link fails (LNK2038) rather
# than the program laying `Local<T>` out two ways.
set(UNIBIND_ARCH "@UNIBIND_ARCH@")
if(NOT CMAKE_SIZEOF_VOID_P EQUAL @CMAKE_SIZEOF_VOID_P@)
    message(FATAL_ERROR
        "unibind: this prefix was installed for ${UNIBIND_ARCH} (sizeof(void*) is @CMAKE_SIZEOF_VOID_P@) "
        "and you are building with sizeof(void*) ${CMAKE_SIZEOF_VOID_P}. "
        "Use the prefix installed for this architecture.")
endif()

if(NOT DEFINED UNIBIND_@UNIBIND_BACKEND_UPPER@_DIR)
    set(UNIBIND_@UNIBIND_BACKEND_UPPER@_DIR "@UNIBIND_ENGINE_DIR@" CACHE PATH "Prebuilt @UNIBIND_BACKEND@ for unibind")
endif()

set(_unibind_engine_lib "${UNIBIND_@UNIBIND_BACKEND_UPPER@_DIR}/@UNIBIND_ENGINE_LIB_NAME@")
if(NOT EXISTS "${_unibind_engine_lib}")
    message(FATAL_ERROR
        "unibind: no @UNIBIND_ENGINE_LIB_NAME@ under UNIBIND_@UNIBIND_BACKEND_UPPER@_DIR='${UNIBIND_@UNIBIND_BACKEND_UPPER@_DIR}'. "
        "The engine is yours to supply; point that variable at a prebuilt @UNIBIND_ARCH@ /MT tree.")
endif()

set(_unibind_backend_lib "${_unibind_prefix}/@UNIBIND_INSTALL_LIB_DIR@/@UNIBIND_BACKEND_LIB_NAME@")
if(NOT EXISTS "${_unibind_backend_lib}")
    message(FATAL_ERROR "unibind: no @UNIBIND_BACKEND_LIB_NAME@ under '${_unibind_prefix}/@UNIBIND_INSTALL_LIB_DIR@'.")
endif()

# Libraries that come with the engine and sit beside it under the same
# directory: the python backend's zlib, openssl and the rest. Empty for the
# JavaScript engines, which are one library each.
set(_unibind_engine_extra_libs "")
foreach(_unibind_lib IN ITEMS @UNIBIND_ENGINE_EXTRA_LIB_NAMES@)
    list(APPEND _unibind_engine_extra_libs "${UNIBIND_@UNIBIND_BACKEND_UPPER@_DIR}/${_unibind_lib}")
endforeach()
unset(_unibind_lib)

# The headers come with it, so that linking a backend is the whole of consuming
# unibind for a target that has its own sources. A target that only *compiles*
# - an object library whose objects are linked twice, once per engine - links
# `unibind::headers` instead and names no backend at all.
add_library(unibind::backend_@UNIBIND_BACKEND@ STATIC IMPORTED)
set_target_properties(unibind::backend_@UNIBIND_BACKEND@ PROPERTIES
    IMPORTED_LOCATION "${_unibind_backend_lib}"
    INTERFACE_LINK_LIBRARIES "unibind::headers;${_unibind_engine_lib};${_unibind_engine_extra_libs};@UNIBIND_ENGINE_SYSTEM_LIBS_CMAKE@")

unset(_unibind_engine_lib)
unset(_unibind_engine_extra_libs)
unset(_unibind_backend_lib)
unset(_unibind_prefix)
